{
  "name": "reset-primal",
  "version": "1.0.0",
  "description": "Reset Primal - Landing page com webhook Hotmart para automação de vendas",
  "main": "api/server.js",
  "scripts": {
    "prepare": "husky install || true",
    "start": "node api/server.js",
    "dev": "node api/server.js",
    "legacy-webhook": "node api/webhook-hotmart.js",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:unit": "jest api/__tests__/unit",
    "test:integration": "jest api/__tests__/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom='api/**/*.js'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headed": "cypress run --headed",
    "lint": "eslint api/ --fix",
    "lint:check": "eslint api/",
    "format": "prettier --write 'api/**/*.js' 'cypress/**/*.js'",
    "lighthouse": "lighthouse http://64.225.44.199 --view",
    "perf:test": "k6 run k6-webhook-perf.js",
    "validate": "npm run lint:check && npm test && npm run test:coverage"
  },
  "lint-staged": {
    "api/**/*.js": ["eslint --fix", "prettier --write"],
    "cypress/**/*.js": ["prettier --write"]
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "reset",
    "primal",
    "hotmart",
    "webhook",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.3",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cypress": "^15.9.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "k6": "^0.0.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
