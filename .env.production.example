# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.production and fill with real values
# NEVER commit this file with real secrets to git

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV=production
PORT=3000

# ========================================
# DATABASE (PostgreSQL in Production)
# ========================================
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://reset_primal_user:SECURE_PASSWORD_HERE@db.example.com:5432/reset_primal?schema=public"

# ========================================
# JWT SECRETS (Must be different from dev!)
# ========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_SECURE_SECRET_HERE_MIN_32_CHARS"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGIN="https://resetprimal.com.br"

# ========================================
# EMAIL SERVICE (SENDGRID)
# ========================================
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@resetprimal.com.br"
EBOOK_DOWNLOAD_URL="https://resetprimal.com.br/ebook"

# ========================================
# HOTMART INTEGRATION
# ========================================
HOTMART_WEBHOOK_SECRET="WEBHOOK_SECRET_FROM_HOTMART"
HOTMART_AFFILIATE_LINK="https://pay.hotmart.com/XXXXX"

# ========================================
# GOOGLE ANALYTICS 4
# ========================================
GOOGLE_ANALYTICS_PROPERTY_ID="G-XXXXXXXXXX"
GOOGLE_ANALYTICS_API_SECRET="SECRET_KEY_FROM_GA4"

# ========================================
# FACEBOOK PIXEL
# ========================================
FACEBOOK_PIXEL_ID="PIXEL_ID_HERE"
FACEBOOK_PIXEL_TOKEN="PIXEL_TOKEN_HERE"

# ========================================
# LOGGING
# ========================================
LOG_LEVEL="info"

# Optional: Send logs to external service
# LOG_SERVICE=datadog|sentry|cloudwatch
# LOG_SERVICE_KEY=YOUR_KEY_HERE
