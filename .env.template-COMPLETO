# ════════════════════════════════════════════════════════════════
# RESET PRIMAL - VARIÁVEIS DE AMBIENTE (COMPLETO)
# ════════════════════════════════════════════════════════════════
#
# 🔐 SEGURANÇA:
# - Nunca commitar .env (use .env.template)
# - Regenerar secrets periodicamente
# - Usar .env.example para desenvolvimento
# - .env.production para produção com valores reais
#
# ════════════════════════════════════════════════════════════════

# SERVER
NODE_ENV=development
PORT=3000
APP_NAME=Reset Primal

# ════════════════════════════════════════════════════════════════
# 🔐 SEGURANÇA - WEBHOOK HOTMART
# ════════════════════════════════════════════════════════════════
#
# Obter em: Hotmart > Integrações > Webhooks
# Secret deve ser copiado apenas UMA VEZ (depois Hotmart não mostra)
#
HOTMART_WEBHOOK_SECRET=cole_seu_secret_hotmart_aqui_EXATAMENTE_COMO_MOSTRADO
HOTMART_AFFILIATE_LINK=https://pay.hotmart.com/SEU_ID_AQUI

# ════════════════════════════════════════════════════════════════
# 📧 EMAIL - SENDGRID (RECOMENDADO)
# ════════════════════════════════════════════════════════════════
#
# ❌ NÃO USE GMAIL (deprecated app passwords)
# ✅ USE SENDGRID (mais seguro, melhor entregabilidade)
#
# Obter em: SendGrid > Settings > API Keys > Create New API Key
# Permissões necessárias: Mail Send
#
SENDGRID_API_KEY=SG.cole_sua_chave_aqui_completa
SENDGRID_FROM_EMAIL=noreply@resetprimal.com.br

# Nome que aparece no "From" do email
SENDGRID_FROM_NAME=Reset Primal

# ════════════════════════════════════════════════════════════════
# 📊 GOOGLE ANALYTICS 4
# ════════════════════════════════════════════════════════════════
#
# Obter em: Google Analytics > Admin > Propriedade > Detalhes da Propriedade
# Measurement ID: Formato G-XXXXXXXXXX
#
# Para API Server-Side:
# 1. Ir em: Admin > Propriedade > Privacidade de Dados
# 2. Copiar Measurement ID
# 3. Ir em: Admin > Data Streams > Web > Web Streams Details
# 4. Copiar Measurement ID (novamente, confirmar)
#
GOOGLE_ANALYTICS_PROPERTY_ID=G-cole_seu_measurement_id_aqui
GOOGLE_ANALYTICS_API_SECRET=cole_seu_api_secret_aqui

# ════════════════════════════════════════════════════════════════
# 📘 FACEBOOK PIXEL (OPCIONAL)
# ════════════════════════════════════════════════════════════════
#
# Obter em: Facebook Business > Events Manager > Pixel ID
#
# Para API Server-Side:
# 1. Ir em: Facebook Business > Business Settings > Data Sources > Datasets
# 2. Criar novo Dataset
# 3. Copiar Pixel ID
# 4. Gerar Access Token
#
FACEBOOK_PIXEL_ID=cole_seu_pixel_id_aqui
FACEBOOK_PIXEL_TOKEN=cole_seu_access_token_aqui

# ════════════════════════════════════════════════════════════════
# 🗂️ BANCO DE DADOS
# ════════════════════════════════════════════════════════════════
#
# SQLite para desenvolvimento (recomendado)
# PostgreSQL para produção
#
# Desenvolvimento (SQLite):
DATABASE_URL=file:./dev.db

# Produção (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/reset_primal

# ════════════════════════════════════════════════════════════════
# 💬 TELEGRAM (OPCIONAL - NOTIFICAÇÕES)
# ════════════════════════════════════════════════════════════════
#
# Obter em:
# 1. Conversar com @BotFather no Telegram
# 2. /newbot → nomear seu bot
# 3. Copiar Token
# 4. Abrir chat com seu bot e enviar mensagem
# 5. curl https://api.telegram.org/bot{TOKEN}/getUpdates
# 6. Procurar por "chat":{"id":... copiar esse ID
#
TELEGRAM_BOT_TOKEN=cole_seu_token_aqui
TELEGRAM_CHAT_ID=cole_seu_chat_id_aqui

# ════════════════════════════════════════════════════════════════
# 📥 E-BOOK (DOWNLOAD LINK)
# ════════════════════════════════════════════════════════════════
#
# URL onde o e-book fica hospedado
# Pode ser: AWS S3, Google Drive, seu servidor, etc.
#
EBOOK_DOWNLOAD_URL=https://resetprimal.com.br/ebook

# ════════════════════════════════════════════════════════════════
# 🔧 DESENVOLVIMENTO
# ════════════════════════════════════════════════════════════════
#
# Ativar logs verbosos
DEBUG=reset-primal:*

# Rate limit: máximo de requisições por minuto
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ════════════════════════════════════════════════════════════════
# 🚀 PRODUÇÃO
# ════════════════════════════════════════════════════════════════
#
# Se NODE_ENV=production, usar valores reais
# Exemplo de variáveis a mudar:
# - NODE_ENV=production (não development!)
# - Todos os secrets devem ser valores reais
# - DATABASE_URL deve apontar para banco de produção
# - Ativar HTTPS (Nginx/Let's Encrypt)
#

# ════════════════════════════════════════════════════════════════
# ✅ COMO VALIDAR ESTE ARQUIVO
# ════════════════════════════════════════════════════════════════
#
# 1. Copiar este arquivo:
#    cp .env.template-COMPLETO .env
#
# 2. Preencher com seus valores reais (ver instruções acima)
#
# 3. Validar:
#    bash scripts/validate-env.sh
#
# 4. Testar webhook:
#    bash scripts/test-webhook.sh localhost
#
# 5. Iniciar servidor:
#    npm start
#

