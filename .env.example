# ════════════════════════════════════════════════════════════════
# RESET PRIMAL - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ════════════════════════════════════════════════════════════════
#
# Para Railway.app: Adicione estas variáveis em Project Settings → Variables
# Para desenvolvimento local: Copie para .env e preencha com valores reais
#

# SERVER
NODE_ENV=production
PORT=3000
APP_NAME=Reset Primal

# 🔐 SEGURANÇA - JWT (Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_required_for_security

# 🔐 SEGURANÇA - WEBHOOK HOTMART
HOTMART_WEBHOOK_SECRET=abc123def456ghi789jkl012mno345pqr678stu901vwx
HOTMART_AFFILIATE_LINK=https://pay.hotmart.com/W103146395W

# 📧 EMAIL - SENDGRID
SENDGRID_API_KEY=SG.test_key_example_12345678901234567890
SENDGRID_FROM_EMAIL=noreply@resetprimal.com.br

# 📊 GOOGLE ANALYTICS 4 (MEASUREMENT PROTOCOL)
# Para obter esses valores:
# 1. Acesse: https://analytics.google.com/
# 2. Selecione a propriedade "Reset Primal"
# 3. Admin → Data Streams → Selecione seu stream (web)
# 4. Scroll down → "Measurement Protocol"
# 5. Clique em "Create" para gerar um novo secret
# 6. Copie o secret gerado aqui
GOOGLE_ANALYTICS_PROPERTY_ID=G-1A2B3C4D5E
GOOGLE_ANALYTICS_API_SECRET=test_api_secret_example_12345

# 🧪 Para testar a integração GA4:
# GET http://localhost:3000/test-ga4?email=test@example.com&value=97
# (Retorna sucesso se GA4 estiver funcionando)

# 📱 FACEBOOK PIXEL (OPCIONAL)
FACEBOOK_PIXEL_ID=123456789012345
FACEBOOK_PIXEL_TOKEN=EAA_test_token_example

# 🗂️ BANCO DE DADOS
# Para Railway: Será injetado automaticamente como variável de ambiente
# Para desenvolvimento local com SQLite: file:./dev.db
# Para desenvolvimento local com PostgreSQL: postgresql://user:password@localhost:5432/reset_primal
DATABASE_URL=postgresql://user:password@localhost:5432/reset_primal

# 💬 TELEGRAM (OPCIONAL)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGHIjklMNOPqrst_test
TELEGRAM_CHAT_ID=12345678

# 📥 E-BOOK
EBOOK_DOWNLOAD_URL=https://resetprimal.com.br/ebook

# 🔧 DESENVOLVIMENTO
DEBUG=reset-primal:*
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
