# ════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES - Reset Primal
# ════════════════════════════════════════════════════════════════
# 
# IMPORTANTE: Copiar este arquivo para .env e preencher com valores reais
# .env está no .gitignore - NUNCA fazer commit de .env com dados reais
# 
# cp .env.example .env
# Depois editar .env com seus valores
#

# ════════════════════════════════════════════════════════════════
# HOTMART - INTEGRAÇÃO DE VENDAS
# ════════════════════════════════════════════════════════════════

# Link de afiliado/principal da LP que leva ao Hotmart checkout
# Exemplo: https://pay.hotmart.com/S96024805Y
HOTMART_AFFILIATE_LINK=

# Webhook secret gerado no Hotmart
# Dashboard → Configurações → Webhooks → Copiar token
HOTMART_WEBHOOK_SECRET=

# Webhook URL que Hotmart chama quando venda é feita
# Geralmente: https://resetprimal.com.br/webhook/hotmart
HOTMART_WEBHOOK_URL=

# (Opcional) API Key Hotmart para consultas
# Needed if you plan to query order status
HOTMART_API_KEY=

# (Opcional) Seller ID no Hotmart
HOTMART_SELLER_ID=


# ════════════════════════════════════════════════════════════════
# GOOGLE ANALYTICS 4 (GA4)
# ════════════════════════════════════════════════════════════════

# Property ID do GA4
# Encontrar em: Google Analytics → Admin → Propriedades → Property ID
# Exemplo: G-XXXXXXXXX (com G- na frente)
GA4_PROPERTY_ID=

# Measurement ID (alias do Property ID, alguns frameworks usam isso)
GA4_MEASUREMENT_ID=

# (Opcional) API Secret para Server-side tracking
GA4_API_SECRET=


# ════════════════════════════════════════════════════════════════
# FACEBOOK PIXEL
# ════════════════════════════════════════════════════════════════

# Pixel ID único do seu negócio
# Encontrar em: Facebook Business → Events Manager → Pixel ID
# Exemplo: 123456789012345
FACEBOOK_PIXEL_ID=

# (Opcional) Conversion API Access Token (para server-side events)
# Mais confiável que client-side tracking
FACEBOOK_CONVERSION_API_TOKEN=


# ════════════════════════════════════════════════════════════════
# EMAIL - SENDGRID (opcional, para confirmação de compra)
# ════════════════════════════════════════════════════════════════

# API Key SendGrid para envio de emails
# Encontrar em: SendGrid → Settings → API Keys
SENDGRID_API_KEY=

# Email FROM padrão (quem envia)
# Exemplo: noreply@resetprimal.com.br
SENDGRID_FROM_EMAIL=

# Email para receber notificações de vendas
# Exemplo: vendas@resetprimal.com.br
ADMIN_EMAIL=


# ════════════════════════════════════════════════════════════════
# BANCO DE DADOS (se usar)
# ════════════════════════════════════════════════════════════════

# URL de conexão do banco (ex: PostgreSQL, MySQL)
# Formato: protocol://user:password@host:port/database
DATABASE_URL=

# Tipo de banco de dados
# Valores: postgresql, mysql, mongodb, firebase
DATABASE_TYPE=


# ════════════════════════════════════════════════════════════════
# APLICAÇÃO
# ════════════════════════════════════════════════════════════════

# Ambiente de execução
# Valores: development, staging, production
NODE_ENV=development

# URL base da aplicação
# Desenvolvimento: http://localhost:8080
# Produção: https://resetprimal.com.br
APP_URL=http://localhost:8080

# Porta de desenvolvimento
APP_PORT=8080

# Debug mode (verbose logging)
# Valores: true, false
DEBUG=false


# ════════════════════════════════════════════════════════════════
# SEGURANÇA
# ════════════════════════════════════════════════════════════════

# JWT Secret para autenticação (se usar)
JWT_SECRET=

# CORS allowed origins (separados por vírgula se múltiplos)
# Exemplo: https://resetprimal.com.br,https://app.resetprimal.com.br
CORS_ORIGINS=

# Rate limiting: máximo de requisições por minuto
RATE_LIMIT=60


# ════════════════════════════════════════════════════════════════
# URLS IMPORTANTES
# ════════════════════════════════════════════════════════════════

# URL do e-book (após compra bem-sucedida)
EBOOK_URL=https://resetprimal.com.br/ebook

# URL da landing page (para redirecionamentos)
LANDING_PAGE_URL=https://resetprimal.com.br

# URL de sucesso (após compra em Hotmart)
# Hotmart redireciona para essa URL quando compra é confirmada
SUCCESS_URL=https://resetprimal.com.br/sucesso

# URL de erro (se compra falhar)
ERROR_URL=https://resetprimal.com.br/erro


# ════════════════════════════════════════════════════════════════
# ANALYTICS CUSTOMIZADAS
# ════════════════════════════════════════════════════════════════

# Habilitar rastreamento de eventos customizados
TRACK_EVENTS=true

# Habilitar rastreamento de scroll depth
TRACK_SCROLL=true

# Habilitar rastreamento de tempo na página
TRACK_TIME=true

# Qual ferramenta usar para analytics
# Valores: ga4, facebook, both
ANALYTICS_PROVIDER=both


# ════════════════════════════════════════════════════════════════
# A/B TESTING
# ════════════════════════════════════════════════════════════════

# Versão da landing page em uso
# Valores: grand-slam, validated, hibrida, completa
LP_VERSION=grand-slam

# Habilitar distribuição randômica entre versões (A/B test)
AB_TEST_ENABLED=false

# Split entre versão A e B (em percentual)
# Exemplo: 50 = 50/50 split, 70 = 70% versão A, 30% versão B
AB_TEST_SPLIT=50


# ════════════════════════════════════════════════════════════════
# LOGS E MONITORAMENTO
# ════════════════════════════════════════════════════════════════

# Nível de log
# Valores: error, warn, info, debug
LOG_LEVEL=info

# Arquivo de log (caminho onde salvar logs)
LOG_FILE=./logs/app.log

# Tamanho máximo de arquivo de log antes de rotar
LOG_MAX_SIZE=10485760


# ════════════════════════════════════════════════════════════════
# INTEGRAÇÕES OPCIONAIS
# ════════════════════════════════════════════════════════════════

# Telegram Bot (para notificações de vendas)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (seu chat ID para receber notificações)
TELEGRAM_CHAT_ID=

# Slack Webhook (para notificações em Slack)
SLACK_WEBHOOK_URL=

# Google Sheets API (se quiser logar vendas em planilha)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
